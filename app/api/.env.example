# Copie para .env e preencha. Nunca versione o .env.
PORT=8787
DATA_DIR=./data
ORIGIN=http://localhost:4449
RP_ID=localhost
RP_NAME=AVAGYM

DB_HOST=localhost
DB_PORT=5432
DB_NAME=avagym
DB_USER=postgres
DB_PASSWORD=

# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_HOURS=168
DEFAULT_TENANT=avadesk
ADMIN_EMAIL=admin@avagym.local
# ADMIN_PASSWORD= (opcional; se vazio o migrate gera uma)

# ---- V4.2 · e-mail (exportação LGPD). Deixe vazio até contratar o provedor: os envios ficam PENDENTES na fila do Postgres.
# Ao configurar: `npm i nodemailer` em app/api, preencha abaixo e reinicie a API (pm2 restart avagym-api --update-env).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# cópia de todo arquivo LGPD enviado (ex.: e-mail do encarregado de dados)
LGPD_COPY_EMAIL=
