{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengym-api",
  "main": "index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "OPENGYM_KV",
      "id": "8d1be09b4a3f4f92814e404d0d7ece35"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "RP_NAME": "natoGym",
    "RP_ID": "opengym-6xo.pages.dev",
    "ORIGIN": "https://opengym-6xo.pages.dev",
    "INVITE_ONLY": "false",
    "SESSION_DAYS": "90"
  }
}
